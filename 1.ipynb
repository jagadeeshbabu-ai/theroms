   ],
   "source": [
    "P_A = 0.80\n",
    "P_B = 0.20\n",
    "\n",
    "P_D_given_A = 0.02\n",
    "P_D_given_B = 0.20\n",
    "\n",
    "# Overall probability of a defective product\n",
    "P_D = (P_D_given_A * P_A) + (P_D_given_B * P_B)\n",
    "\n",
    "# Bayes theorem\n",
    "result = (P_D_given_B * P_B) / P_D\n",
    "\n",
    "print(\"Probability:\", result)\n",
    "print(\"Percentage:\", result * 100, \"%\")"
   ]
  }
 ],
